
@page "{id:int}"
@model JobManagement.Pages.Jobs.EditModel

<h2>Edit Job</h2>

<h2>Edit Job</h2>

<form method="post">

    <div class="form-group">
        <label asp-for="Job.JobTitle" class="control-label"></label>
        <input asp-for="Job.JobTitle" class="form-control" />
        <span asp-validation-for="Job.JobTitle" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Job.Company" class="control-label"></label>
        <input asp-for="Job.Company" class="form-control" />
        <span asp-validation-for="Job.Company" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Job.Location" class="control-label"></label>
        <input asp-for="Job.Location" class="form-control" />
        <span asp-validation-for="Job.Location" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Job.EmploymentType" class="control-label"></label>
        <input asp-for="Job.EmploymentType" class="form-control" />
        <span asp-validation-for="Job.EmploymentType" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Job.SalaryRange" class="control-label"></label>
        <input asp-for="Job.SalaryRange" class="form-control" />
        <span asp-validation-for="Job.SalaryRange" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Job.JobDescription" class="control-label"></label>
        <textarea asp-for="Job.JobDescription" class="form-control"></textarea>
        <span asp-validation-for="Job.JobDescription" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Job.Requirements" class="control-label"></label>
        <textarea asp-for="Job.Requirements" class="form-control"></textarea>
        <span asp-validation-for="Job.Requirements" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="ExpirationDate" class="control-label"></label>
        <input asp-for="ExpirationDate" type="date" class="form-control" />
        <span asp-validation-for="ExpirationDate" class="text-danger"></span>
    </div>

    <br />

    <button type="submit" class="btn btn-success">
        Update
    </button>

    <a asp-page="Index" class="btn btn-secondary">
        Back
    </a>

</form>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}