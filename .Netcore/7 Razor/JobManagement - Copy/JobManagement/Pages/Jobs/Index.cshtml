@page 
@model JobManagement.Pages.Jobs.IndexModel
@{
}
<h2>Job Listings</h2>


<p>
    <a asp-page="Create" class="btn btn-primary">
        Add New Job
    </a>
</p>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Job Title</th>
            <th>Company</th>
            <th>Location</th>
            <th>Employment Type</th>
            <th>Salary</th>
            <th>Posted Date</th>
            <th>Expiration Date</th>
            <th>Action</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var item in Model.Jobs)
        {
            <tr>

                <td>@item.JobTitle</td>

                <td>@item.Company</td>

                <td>@item.Location</td>

                <td>@item.EmploymentType</td>

                <td>@item.SalaryRange</td>

                <td>@item.PostedDate.ToShortDateString()</td>

                <td>@item.ExpirationDate.ToShortDateString()</td>

                <td>

                    <a asp-page="Edit"
                       asp-route-id="@item.Id"
                       class="btn btn-warning">
                        Edit
                    </a>

                    <a asp-page="Delete"
                       asp-route-id="@item.Id"
                       class="btn btn-danger">
                        Delete
                    </a>

                </td>

            </tr>
        }

    </tbody>

</table>>

