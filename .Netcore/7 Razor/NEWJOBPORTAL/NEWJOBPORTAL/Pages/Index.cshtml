

@page
@model IndexModel

@{
    ViewData["Title"] = "Available Jobs";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Available Jobs</h1>

        <a asp-page="/Jobs/Create" class="btn btn-primary">
            Post New Job
        </a>
    </div>

    @if (Model.JobPosts.Any())
    {
        <div class="row">

            @foreach (var job in Model.JobPosts)
            {
                <div class="col-md-6 col-lg-4 mb-4">

                    <div class="card h-100 shadow-sm">

                        <div class="card-body">

                            <h4 class="card-title">
                                @job.Title
                            </h4>

                            <h6 class="text-muted mb-3">
                                @job.Company
                            </h6>

                            <p>
                                <strong>Location:</strong>
                                @job.Location
                            </p>

                            <p>
                                <strong>Salary:</strong>
                                @job.Salary?.ToString("C")

                            </p>

                            <p>
                                <strong>Posted:</strong>
                                @job.PostedDate.ToString("dd-MM-yyyy")
                            </p>

                            <p class="card-text">
                                @job.Description
                            </p>

                            <div class="mt-3">

                                <a asp-page="/Jobs/Details"
                                   asp-route-id="@job.Id"
                                   class="btn btn-primary">
                                    View Details
                                </a>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }
    else
    {
        <div class="alert alert-info">
            No jobs are currently available.
        </div>
    }

</div>
